rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // HELPER FUNCTIONS & AUTHENTICATION PREDICATES
    // ----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isModeratorOrAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['moderator', 'admin'])
      );
    }

    function isQuestionOwner(questionId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/questionOwners/$(questionId)) &&
        get(/databases/$(database)/documents/questionOwners/$(questionId)).data.ownerUid == request.auth.uid;
    }

    function isAnswerOwner(answerId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/answerOwners/$(answerId)) &&
        get(/databases/$(database)/documents/answerOwners/$(answerId)).data.ownerUid == request.auth.uid;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------------------------
    // CATEGORIES (Application Configuration Data)
    // - Public read for all clients
    // - Writes strictly locked to admin
    // ----------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isModeratorOrAdmin();
    }

    // ----------------------------------------------------------------------
    // PRIVATE QUESTION OWNERSHIP
    // - STRICT PRIVACY: Public users cannot read
    // - Authenticated author can read own ownership record
    // - Created upon question creation
    // ----------------------------------------------------------------------
    match /questionOwners/{questionId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isModeratorOrAdmin());
      allow create: if isSignedIn()
        && isValidId(questionId)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ----------------------------------------------------------------------
    // PRIVATE ANSWER OWNERSHIP
    // - STRICT PRIVACY: Public users cannot read
    // - Authenticated author can read own ownership record
    // ----------------------------------------------------------------------
    match /answerOwners/{answerId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isModeratorOrAdmin());
      allow create: if isSignedIn()
        && isValidId(answerId)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ----------------------------------------------------------------------
    // USERS (Profiles)
    // - Anyone can read public profiles
    // - User can create initial profile (0 reputation, 'member' role)
    // - User CANNOT tamper with reputation, role, or server counters
    // - Moderator/Admin can update status (suspend, ban)
    // ----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['id', 'displayName', 'username', 'reputation', 'role', 'createdAt'])
        && request.resource.data.id == userId
        && request.resource.data.reputation == 0
        && request.resource.data.role == 'member'
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30;

      allow update: if (
        // Owner updating editable profile fields
        (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reputation', 'role', 'id', 'createdAt', 'questionCount', 'answerCount', 'followersCount', 'followingCount', 'status'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2
          && request.resource.data.displayName.size() <= 50)
        ||
        // Moderator/Admin setting status
        (isModeratorOrAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );

      allow delete: if false; // Soft delete via status = 'deleted'

      // Private device tokens (FCM) - never readable by other users
      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // Private settings
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ----------------------------------------------------------------------
    // USERNAMES (Unique username reservation)
    // ----------------------------------------------------------------------
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidId(username);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ----------------------------------------------------------------------
    // QUESTIONS
    // - Public read for all questions
    // - Authenticated creation
    // - Anonymous posting: authorUid MUST NOT be in public doc when isAnonymous == true
    // - Author can update title, body, tags OR helpfulAnswerId OR status
    // - Protected counters (voteCount, answerCount, viewCount) cannot be forged
    // ----------------------------------------------------------------------
    match /questions/{questionId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidId(questionId)
        // Anonymous check: authorUid MUST NOT be set if anonymous
        && (
          (request.resource.data.isAnonymous == true && (!('authorUid' in request.resource.data) || request.resource.data.authorUid == null || request.resource.data.authorUid == ''))
          ||
          (request.resource.data.isAnonymous == false && request.resource.data.authorUid == request.auth.uid)
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 8
        && request.resource.data.title.size() <= 250
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 15
        && request.resource.data.body.size() <= 10000
        && request.resource.data.voteCount == 0
        && request.resource.data.answerCount == 0
        && request.resource.data.viewCount == 0
        && request.resource.data.status in ['active', 'resolved', 'closed'];

      allow update: if isSignedIn() && (
        // Question owner updating content
        (isQuestionOwner(questionId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorUid', 'createdAt', 'voteCount', 'answerCount', 'viewCount', 'id'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 8
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 15)
        ||
        // Question owner setting accepted answer
        (isQuestionOwner(questionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulAnswerId', 'updatedAt']))
        ||
        // Question owner closing or resolving
        (isQuestionOwner(questionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['active', 'closed', 'resolved'])
        ||
        // Moderator removing question
        (isModeratorOrAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );

      allow delete: if isQuestionOwner(questionId) || isModeratorOrAdmin();

      // Question views subcollection: log view deterministically
      match /views/{viewerUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(viewerUid);
      }
    }

    // ----------------------------------------------------------------------
    // ANSWERS
    // - Public read for all answers
    // - Anonymous posting: authorUid omitted when isAnonymous == true
    // - Author can update body only
    // - Question author can toggle isHelpful flag
    // ----------------------------------------------------------------------
    match /answers/{answerId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidId(answerId)
        && (
          (request.resource.data.isAnonymous == true && (!('authorUid' in request.resource.data) || request.resource.data.authorUid == null || request.resource.data.authorUid == ''))
          ||
          (request.resource.data.isAnonymous == false && request.resource.data.authorUid == request.auth.uid)
        )
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 5
        && request.resource.data.body.size() <= 10000
        && request.resource.data.voteCount == 0
        && request.resource.data.helpfulCount == 0
        && request.resource.data.status == 'active';

      allow update: if isSignedIn() && (
        // Author editing body
        (isAnswerOwner(answerId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorUid', 'questionId', 'createdAt', 'voteCount', 'helpfulCount', 'id']))
        ||
        // Question owner marking answer helpful
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHelpful', 'updatedAt'])
          && isQuestionOwner(resource.data.questionId))
        ||
        // Moderator removing answer
        (isModeratorOrAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );

      allow delete: if isAnswerOwner(answerId) || isModeratorOrAdmin();
    }

    // ----------------------------------------------------------------------
    // COMMENTS
    // - Public read for comments
    // - Authenticated user can create comment
    // - Author can edit or soft-delete comment
    // ----------------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(commentId)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 1000;

      allow update: if isSignedIn() && (
        (resource.data.authorUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorUid', 'targetId', 'targetType', 'createdAt', 'id']))
        ||
        (isModeratorOrAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );

      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isModeratorOrAdmin());
    }

    match /commentLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ----------------------------------------------------------------------
    // VOTES
    // - Deterministic vote records keyed by {targetId}_{uid}
    // - User can ONLY vote once with value +1 or -1
    // - User can ONLY manage their own vote record
    // ----------------------------------------------------------------------
    match /votes/{voteId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && voteId == request.resource.data.targetId + '_' + request.auth.uid
        && (request.resource.data.value == 1 || request.resource.data.value == -1);

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && voteId == resource.data.targetId + '_' + request.auth.uid
        && (request.resource.data.value == 1 || request.resource.data.value == -1);

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ----------------------------------------------------------------------
    // FOLLOWS (User, Category, Question)
    // ----------------------------------------------------------------------
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.followerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /categoryFollows/{catFollowId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /questionFollows/{qFollowId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ----------------------------------------------------------------------
    // SAVED QUESTIONS & COLLECTIONS (Bookmarks)
    // ----------------------------------------------------------------------
    match /savedQuestions/{saveId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /collections/{collectionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ----------------------------------------------------------------------
    // NOTIFICATIONS
    // - Recipient can read and mark as read
    // - Sender must be signed in, recipient != sender, type in whitelist
    // ----------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.isRead == false
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 3
        && request.resource.data.body.size() <= 500
        && (
          (
            request.resource.data.type == 'follow'
            && request.resource.data.targetType == 'user'
            && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + request.resource.data.targetId))
            && get(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + request.resource.data.targetId)).data.followerUid == request.auth.uid
            && get(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + request.resource.data.targetId)).data.followingUid == request.resource.data.recipientUid
          )
          || (
            request.resource.data.type == 'answer'
            && request.resource.data.targetType == 'question'
            && exists(/databases/$(database)/documents/questions/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/questions/$(request.resource.data.targetId)).data.authorUid == request.resource.data.recipientUid
            && get(/databases/$(database)/documents/questions/$(request.resource.data.targetId)).data.authorUid != request.auth.uid
          )
        );

      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);

      allow delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }

    // ----------------------------------------------------------------------
    // REPORTS (Abuse & Safety)
    // ----------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string;
      allow read: if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isModeratorOrAdmin());
      allow update: if isModeratorOrAdmin();
      allow delete: if isModeratorOrAdmin();
    }

    // ----------------------------------------------------------------------
    // AUDIT LOGS (Moderation & Administrative actions)
    // ----------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isModeratorOrAdmin();
      allow create: if isModeratorOrAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ----------------------------------------------------------------------
    // BLOCKS & MUTES
    // ----------------------------------------------------------------------
    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    match /mutes/{muteId} {
      allow read: if isSignedIn() && resource.data.muterUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.muterUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.muterUid == request.auth.uid;
      allow update: if false;
    }
  }
}
